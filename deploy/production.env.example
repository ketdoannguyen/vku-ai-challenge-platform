# Mẫu env cho stack production (docker-compose.prod.yml).
#
#   sudo install -m 600 -o root -g root deploy/production.env.example /srv/vku-ai-challenge/.env
#   sudo nano /srv/vku-ai-challenge/.env   # thay mọi placeholder
#
# File này chỉ được đưa vào Compose qua `--env-file`, KHÔNG mount vào container. Service `api`
# nhận đúng danh sách biến khai báo trong compose vì Settings của backend đặt extra="forbid".
# Tuyệt đối không commit file .env thật (đã có trong .gitignore).

# --- Dữ liệu trên host (bind mount, nằm ngoài repo) ---
PROD_DATA_ROOT=/srv/vku-ai-challenge/data

# --- MongoDB ---
MONGO_USER=vku_app
# Sinh bằng: openssl rand -hex 24   (hex để không phải escape khi truyền trong shell/lệnh dump)
MONGO_PASSWORD=THAY_BANG_CHUOI_HEX_48_KY_TU
MONGO_DATABASE=ai_challenge

# --- Phiên đăng nhập ---
SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_NAME=aic_session
# auto => cookie Secure tự bật khi APP_ENV=production (đứng sau HTTPS của Cloudflare Tunnel)
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_SAMESITE=lax

# --- Giới hạn dung lượng (MB) ---
MAX_UPLOAD_MB=10
MAX_NOTEBOOK_MB=20
MAX_CONTENT_MB=2
MAX_ASSET_MB=2

# --- MinIO: artifact của submission (prediction CSV + notebook) ---
# Bucket private, không publish port, không route Nginx; mọi lượt tải đi qua FastAPI (ADR-028).
#
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD chỉ được truyền cho `minio` và `minio-init`.
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY là credential của app, chỉ `api` và lệnh backup nhận.
# Đổi MINIO_SECRET_KEY xong thì chạy lại `minio-init` để cấp lại credential cho app user.
MINIO_ROOT_USER=vku-minio-root
# Sinh bằng: openssl rand -hex 24
MINIO_ROOT_PASSWORD=THAY_BANG_CHUOI_HEX_48_KY_TU
MINIO_ACCESS_KEY=vku-submission-artifacts
# Sinh bằng: openssl rand -hex 24
MINIO_SECRET_KEY=THAY_BANG_CHUOI_HEX_48_KY_TU
MINIO_BUCKET=submission-artifacts

# --- Hiển thị ---
APP_NAME=AI Challenge Platform

# --- AI Notebook Review (ADR-036): tuỳ chọn ---
# Production Compose đọc nhóm này bằng `${VAR:-}` chứ KHÔNG `${VAR:?}`: thiếu cấu hình AI chỉ làm
# tính năng AI không bật được, tuyệt đối không được chặn deploy. Credential Mongo/MinIO ở trên vẫn
# fail-fast như cũ vì thiếu chúng thì stack không chạy được thật.
#
# Cả `api` lẫn `ai-review-worker` nhận đúng nhóm biến này; không service nào nhận cả file .env.
#
# Khoá Fernet mã hoá API key provider trong Mongo (rỗng = không lưu được key).
#   Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Đổi khoá này làm mọi ciphertext cũ không giải mã được -> phải nhập lại API key ở từng cuộc thi.
LLM_CONFIG_ENCRYPTION_KEY=
# Biên mạng: admin được trỏ provider tới BẤT KỲ hostname/IP công khai nào - không cần khai allowlist.
# Nội dung notebook của thí sinh sẽ được gửi tới host đó, và admin phải xác nhận điều đó một lần cho
# mỗi cuộc thi trước khi bật AI. Loopback/mạng nội bộ/metadata vẫn bị chặn ở tầng phân giải DNS.
# Hai danh sách dưới mặc định rỗng = từ chối. Chỉ mở khi thật sự chạy provider tự dựng trong mạng
# nội bộ, và chỉ trong thời gian cần thiết:
#   *_ALLOWED_PRIVATE_HOSTS: cho phép host nội bộ (localhost, 10.x, 192.168.x...) - mở rộng SSRF.
#   *_ALLOWED_HTTP_HOSTS:    cho phép http:// thay vì bắt buộc https:// - nội dung notebook đi trần.
AI_REVIEW_ALLOWED_PRIVATE_HOSTS=
AI_REVIEW_ALLOWED_HTTP_HOSTS=
AI_REVIEW_ALLOWED_PORTS=443
# Nhịp và ngân sách của worker `ai-review-worker` (cần đủ env cho cả ba giá trị dưới):
#   HEARTBEAT bắt buộc NHỎ HƠN LEASE, nếu không worker thoát ngay với mã 2 và systemd/docker dựng lại
#   vô ích. Một job bị cắt giữa chừng (hết `stop_grace_period`) được lease hết hạn thu hồi ở lượt sau.
AI_REVIEW_POLL_INTERVAL_SECONDS=5
AI_REVIEW_LEASE_SECONDS=180
AI_REVIEW_HEARTBEAT_SECONDS=45
AI_REVIEW_MAX_ATTEMPTS=3
AI_REVIEW_CONNECT_TIMEOUT_SECONDS=5
AI_REVIEW_REQUEST_TIMEOUT_SECONDS=60
# Ngân sách output một lượt review (ADR-039) - trần cứng phía mình, không phải giới hạn của model.
# Thấp hơn nhu cầu thật thì câu trả lời bị cắt giữa chừng; lượt đó hỏng với `AI_OUTPUT_TRUNCATED`
# chứ không ra kết luận thiếu. ADR-044: prompt đã dặn model ngân sách mềm 8000 token để nó tự kết
# thúc, nên trần này chỉ còn là lưới an toàn - vẫn phải tăng khi đổi sang model dài dòng.
AI_REVIEW_MAX_OUTPUT_TOKENS=12000

# --- Cloudflare Tunnel: chỉ dùng khi chạy kèm deploy/docker-compose.tunnel.named.yml ---
# Bỏ trống khi dùng Quick Tunnel (mặc định). Lấy token trong Zero Trust Dashboard ở mục
# Networks > Tunnels > chọn tunnel > Install connector; KHÔNG dán token vào repo/chat/log.
CLOUDFLARE_TUNNEL_TOKEN=
