# Mẫu env cho stack production (docker-compose.prod.yml).
#
#   sudo install -m 600 -o root -g root deploy/production.env.example /srv/vku-ai-challenge/.env
#   sudo nano /srv/vku-ai-challenge/.env   # thay mọi placeholder
#
# File này chỉ được đưa vào Compose qua `--env-file`, KHÔNG mount vào container. Service `api`
# nhận đúng danh sách biến khai báo trong compose vì Settings của backend đặt extra="forbid".
# Tuyệt đối không commit file .env thật (đã có trong .gitignore).

# --- Dữ liệu trên host (bind mount, nằm ngoài repo) ---
PROD_DATA_ROOT=/srv/vku-ai-challenge/data

# --- MongoDB ---
MONGO_USER=vku_app
# Sinh bằng: openssl rand -hex 24   (hex để không phải escape khi truyền trong shell/lệnh dump)
MONGO_PASSWORD=THAY_BANG_CHUOI_HEX_48_KY_TU
MONGO_DATABASE=ai_challenge

# --- Phiên đăng nhập ---
SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_NAME=aic_session
# auto => cookie Secure tự bật khi APP_ENV=production (đứng sau HTTPS của Cloudflare Tunnel)
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_SAMESITE=lax

# --- Giới hạn dung lượng (MB) ---
MAX_UPLOAD_MB=10
MAX_NOTEBOOK_MB=20
MAX_CONTENT_MB=2
MAX_ASSET_MB=2

# --- MinIO: artifact của submission (prediction CSV + notebook) ---
# Bucket private, không publish port, không route Nginx; mọi lượt tải đi qua FastAPI (ADR-028).
#
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD chỉ được truyền cho `minio` và `minio-init`.
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY là credential của app, chỉ `api` và lệnh backup nhận.
# Đổi MINIO_SECRET_KEY xong thì chạy lại `minio-init` để cấp lại credential cho app user.
MINIO_ROOT_USER=vku-minio-root
# Sinh bằng: openssl rand -hex 24
MINIO_ROOT_PASSWORD=THAY_BANG_CHUOI_HEX_48_KY_TU
MINIO_ACCESS_KEY=vku-submission-artifacts
# Sinh bằng: openssl rand -hex 24
MINIO_SECRET_KEY=THAY_BANG_CHUOI_HEX_48_KY_TU
MINIO_BUCKET=submission-artifacts

# --- Hiển thị ---
APP_NAME=AI Challenge Platform

# --- Cloudflare Tunnel: chỉ dùng khi chạy kèm deploy/docker-compose.tunnel.named.yml ---
# Bỏ trống khi dùng Quick Tunnel (mặc định). Lấy token trong Zero Trust Dashboard ở mục
# Networks > Tunnels > chọn tunnel > Install connector; KHÔNG dán token vào repo/chat/log.
CLOUDFLARE_TUNNEL_TOKEN=
