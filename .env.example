# AI Challenge Platform - environment template
# Copy thanh .env va thay gia tri that. KHONG commit file .env.

# --- Application ---
APP_ENV=development            # development | production
APP_NAME=AI Challenge Platform
WEB_PORT=8080                  # port cua web (Nginx) tren host khi docker compose up

# --- MongoDB ---
MONGO_HOST=localhost           # ten container trong docker compose, vi du: mongo
MONGO_PORT=27017
MONGO_DATABASE=ai_challenge
MONGO_USER=changeme
MONGO_PASSWORD=changeme

# --- Session ---
SESSION_SECRET=changeme        # random string dai, dung derive/signed cookie neu can
SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_NAME=aic_session
SESSION_COOKIE_SECURE=auto     # auto: true khi APP_ENV=production, nguoc lai false
SESSION_COOKIE_SAMESITE=lax    # lax | strict

# --- Upload ---
MAX_UPLOAD_MB=10               # gioi han file submission CSV
MAX_NOTEBOOK_MB=20             # gioi han notebook .ipynb (bat buoc trong moi submission)
MAX_CONTENT_MB=2               # gioi han file Markdown (.md)
MAX_ASSET_MB=2                 # gioi han anh PNG/JPEG/GIF/WebP; khong ho tro SVG

# --- Data directories (source of truth tren persistent disk) ---
DATA_DIR=./data                # local dev; production thuong la /data

# --- MinIO: artifact cua submission (prediction CSV + notebook) ---
# Bucket private, khong publish port, khong route Nginx; upload/download deu qua FastAPI (ADR-028).
# MINIO_ROOT_*: chi service `minio` va `minio-init` nhan. MINIO_ACCESS_KEY/SECRET_KEY: chi API nhan.
# Gia tri duoi day la mac dinh dev (MinIO khong mo ra host). Production phai doi het.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=appsecret
MINIO_BUCKET=submission-artifacts

# --- AI Notebook Review (ADR-036) ---
# Tuỳ chọn: thiếu cấu hình KHÔNG làm app hỏng - nộp bài, chấm điểm và xếp hạng vẫn nguyên vẹn, chỉ
# tính năng AI là không bật được. Cả `api` lẫn worker `ai-review-worker` đọc nhóm biến này.
#
# Khoá Fernet để mã hoá API key provider lưu trong Mongo. Rỗng = không lưu được key.
#   Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CONFIG_ENCRYPTION_KEY=
# Biên mạng: admin được trỏ provider tới BẤT KỲ hostname/IP công khai nào - không cần khai allowlist.
# Thứ giữ dữ liệu notebook ở đúng chỗ là ô xác nhận chuyển dữ liệu theo từng host trong tab Cài đặt.
# Hai danh sách dưới chỉ dành cho provider tự dựng khi phát triển, khớp CHÍNH XÁC, mặc định rỗng.
#   *_ALLOWED_PRIVATE_HOSTS: cho phép host nội bộ (localhost, 10.x, 192.168.x...).
#   *_ALLOWED_HTTP_HOSTS:    cho phép http:// thay vì bắt buộc https://.
AI_REVIEW_ALLOWED_PRIVATE_HOSTS=
AI_REVIEW_ALLOWED_HTTP_HOSTS=
AI_REVIEW_ALLOWED_PORTS=443
# Nhịp của worker `ai-review-worker`; HEARTBEAT bắt buộc NHỎ HƠN LEASE, nếu không worker thoát mã 2.
AI_REVIEW_POLL_INTERVAL_SECONDS=5
AI_REVIEW_LEASE_SECONDS=180
AI_REVIEW_HEARTBEAT_SECONDS=45
# Ngân sách output của MỘT lượt review - trần cứng phía mình, không phải giới hạn của model. Đặt
# thấp hơn nhu cầu thật thì câu trả lời bị cắt giữa chừng và lượt đó hỏng với `AI_OUTPUT_TRUNCATED`
# thay vì ra một kết luận thiếu. Cùng một model có thể cần ít/nhiều token tuỳ notebook.
AI_REVIEW_MAX_OUTPUT_TOKENS=8000

# --- Production only: Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
